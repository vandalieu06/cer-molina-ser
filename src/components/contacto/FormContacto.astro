<div
  class="bg-white rounded-3xl p-8 md:p-10 shadow-2xl shadow-gray-200/50 border border-gray-100"
>
  <form class="space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="flex flex-col gap-2">
        <label
          class="text-xs font-bold text-gray-500 uppercase tracking-widest ml-1"
          >Nombre</label
        >
        <input
          type="text"
          placeholder="Tu nombre"
          class="p-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-700 outline-none transition-all"
        />
      </div>
      <div class="flex flex-col gap-2">
        <label
          class="text-xs font-bold text-gray-500 uppercase tracking-widest ml-1"
          >Asunto</label
        >
        <select
          class="p-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-700 outline-none transition-all text-gray-600"
        >
          <option>Consulta General</option>
          <option>Adopciones</option>
          <option>Voluntariado / Socios</option>
          <option>Reportar Incidencia</option>
        </select>
      </div>
    </div>

    <div class="flex flex-col gap-2">
      <label
        class="text-xs font-bold text-gray-500 uppercase tracking-widest ml-1"
        >Email</label
      >
      <input
        type="email"
        placeholder="tu@email.com"
        class="p-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-700 outline-none transition-all"
      />
    </div>

    <div class="flex flex-col gap-2">
      <label
        class="text-xs font-bold text-gray-500 uppercase tracking-widest ml-1"
        >Mensaje</label
      >
      <textarea
        rows="5"
        placeholder="¿En qué podemos ayudarte?"
        class="p-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-700 outline-none transition-all resize-none"
      ></textarea>
    </div>

    <button
      class="w-full py-4 bg-blue-700 hover:bg-blue-800 text-white font-black rounded-xl transition-all shadow-lg shadow-blue-200 uppercase tracking-widest text-sm"
    >
      Enviar Mensaje
    </button>
  </form>
</div>
