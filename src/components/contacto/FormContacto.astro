<div
  class="bg-white rounded-2xl p-8 md:p-10 shadow-2xl shadow-maroon-500/5 border border-cream-dark"
>
  <form
    action="https://api.web3forms.com/submit"
    method="POST"
    class="space-y-6"
  >
    <input type="hidden" name="access_key" value="82fceeb0-48c5-4138-af13-14a3758e082e" />
    <input type="hidden" name="subject" value="Nuevo mensaje desde CER Molina Segura" />
    <input type="hidden" name="from_name" value="CER Molina Segura" />
    <input type="hidden" name="redirect" value="/gracias" />
    <input type="checkbox" name="botcheck" style="display: none;" />
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="flex flex-col gap-2">
        <label
          class="text-xs font-bold text-neutral-light uppercase tracking-widest ml-1 font-sans"
          >Nombre</label
        >
        <input
          type="text"
          name="name"
          required
          placeholder="Tu nombre"
          class="p-4 bg-cream border border-cream-dark rounded-xl focus:ring-2 focus:ring-maroon-500 outline-none transition-all font-sans"
        />
      </div>
      <div class="flex flex-col gap-2">
        <label
          class="text-xs font-bold text-neutral-light uppercase tracking-widest ml-1 font-sans"
          >Asunto</label
        >
        <select
          name="subject"
          class="p-4 bg-cream border border-cream-dark rounded-xl focus:ring-2 focus:ring-maroon-500 outline-none transition-all text-neutral font-sans"
        >
          <option>Consulta General</option>
          <option>Adopciones</option>
          <option>Voluntariado / Socios</option>
          <option>Reportar Incidencia</option>
        </select>
      </div>
    </div>

    <div class="flex flex-col gap-2">
      <label
        class="text-xs font-bold text-neutral-light uppercase tracking-widest ml-1 font-sans"
        >Email</label
      >
      <input
        type="email"
        name="email"
        required
        placeholder="tu@email.com"
        class="p-4 bg-cream border border-cream-dark rounded-xl focus:ring-2 focus:ring-maroon-500 outline-none transition-all font-sans"
      />
    </div>

    <div class="flex flex-col gap-2">
      <label
        class="text-xs font-bold text-neutral-light uppercase tracking-widest ml-1 font-sans"
        >Mensaje</label
      >
      <textarea
        name="message"
        required
        rows="5"
        placeholder="¿En qué podemos ayudarte?"
        class="p-4 bg-cream border border-cream-dark rounded-xl focus:ring-2 focus:ring-maroon-500 outline-none transition-all resize-none font-sans"
      ></textarea>
    </div>

    <button
      type="submit"
      class="w-full py-4 bg-maroon-500 hover:bg-maroon-600 text-white font-black rounded-xl transition-all shadow-lg shadow-maroon-500/10 uppercase tracking-widest text-sm font-sans"
    >
      Enviar Mensaje
    </button>
  </form>
</div>
