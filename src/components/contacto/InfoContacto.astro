---
import {
  Mail,
  Instagram,
  Facebook,
  Music2,
} from "@lucide/astro";

const redes = [
  {
    nombre: "Facebook",
    icon: Facebook,
    href: "https://www.facebook.com/CERMolinadeSegura/",
    color: "hover:text-gold",
  },
  {
    nombre: "Instagram",
    icon: Instagram,
    href: "https://www.instagram.com/cermolinadesegura/",
    color: "hover:text-gold",
  },
  {
    nombre: "TikTok",
    icon: Music2,
    href: "https://www.tiktok.com/@cermolinadesegura?is_from_webapp=1&sender_device=pc",
    color: "hover:text-gold",
  },
];
---

<div class="flex flex-col gap-10">
  <div>
    <span class="text-gold font-semibold tracking-widest uppercase text-sm font-sans"
      >Hablemos</span
    >
    <h2
      class="text-4xl font-bold text-maroon-900 tracking-tight italic mt-2 mb-6 font-serif"
    >
      Estamos aquí para <span class="text-maroon-500">ayudarte</span>
    </h2>
    <p class="text-neutral text-lg leading-relaxed font-sans">
      ¿Tienes dudas sobre una adopción? ¿Quieres reportar una colonia? Nuestro
      equipo de voluntarios te responderá lo antes posible.
    </p>
  </div>

  <div class="space-y-6">
    <div
      class="flex items-center gap-4 p-6 bg-white rounded-2xl border border-cream-dark group hover:border-maroon-200 transition-colors"
    >
      <div
        class="w-12 h-12 bg-maroon-500 text-white rounded-xl flex items-center justify-center shadow-lg shadow-maroon-500/10"
      >
        <Mail size={24} />
      </div>
      <div>
        <p class="text-xs font-bold text-neutral-light uppercase tracking-widest font-sans">
          Correo Electrónico
        </p>
        <a
          href="mailto:info@cermolinasegura.com"
          class="text-xl font-bold text-maroon-900 hover:text-maroon-500 transition-colors font-serif"
        >
          info@cermolinasegura.com
        </a>
      </div>
    </div>
  </div>

  <div>
    <p class="text-sm font-bold text-neutral-light uppercase tracking-widest mb-6 font-sans">
      Síguenos en redes
    </p>
    <div class="flex gap-4">
      {
        redes.map((red) => (
          <a
            href={red.href}
            class={`w-12 h-12 bg-white border border-cream-dark rounded-xl flex items-center justify-center text-neutral-light transition-all shadow-sm ${red.color} hover:border-current hover:scale-110`}
            aria-label={red.nombre}
            target="_blank"
            rel="noopener noreferrer"
          >
            <red.icon size={24} />
          </a>
        ))
      }
    </div>
  </div>
</div>
