---
import {
  Mail,
  Instagram,
  Facebook,
  Twitter,
  MessageCircle,
} from "@lucide/astro";

const redes = [
  {
    nombre: "Instagram",
    icon: Instagram,
    href: "#",
    color: "hover:text-pink-500",
  },
  {
    nombre: "Facebook",
    icon: Facebook,
    href: "#",
    color: "hover:text-blue-600",
  },
  {
    nombre: "X (Twitter)",
    icon: Twitter,
    href: "#",
    color: "hover:text-black",
  },
  {
    nombre: "WhatsApp",
    icon: MessageCircle,
    href: "#",
    color: "hover:text-green-500",
  },
];
---

<div class="flex flex-col gap-10">
  <div>
    <span class="text-blue-400 font-semibold tracking-widest uppercase text-sm"
      >Hablemos</span
    >
    <h2
      class="text-4xl font-bold text-gray-900 tracking-tight italic mt-2 mb-6"
    >
      Estamos aquí para <span class="text-blue-700">ayudarte</span>
    </h2>
    <p class="text-gray-600 text-lg leading-relaxed">
      ¿Tienes dudas sobre una adopción? ¿Quieres reportar una colonia? Nuestro
      equipo de voluntarios te responderá lo antes posible.
    </p>
  </div>

  <div class="space-y-6">
    <div
      class="flex items-center gap-4 p-6 bg-gray-50 rounded-2xl border border-gray-100 group hover:border-blue-200 transition-colors"
    >
      <div
        class="w-12 h-12 bg-blue-700 text-white rounded-xl flex items-center justify-center shadow-lg shadow-blue-100"
      >
        <Mail size={24} />
      </div>
      <div>
        <p class="text-xs font-bold text-gray-400 uppercase tracking-widest">
          Correo Electrónico
        </p>
        <a
          href="mailto:info@cermolinasegura.com"
          class="text-xl font-bold text-gray-900 hover:text-blue-700 transition-colors"
        >
          info@cermolinasegura.com
        </a>
      </div>
    </div>
  </div>

  <div>
    <p class="text-sm font-bold text-gray-400 uppercase tracking-widest mb-6">
      Síguenos en redes
    </p>
    <div class="flex gap-4">
      {
        redes.map((red) => (
          <a
            href={red.href}
            class={`w-12 h-12 bg-white border border-gray-200 rounded-xl flex items-center justify-center text-gray-400 transition-all shadow-sm ${red.color} hover:border-current hover:scale-110`}
            aria-label={red.nombre}
          >
            <red.icon size={24} />
          </a>
        ))
      }
    </div>
  </div>
</div>
