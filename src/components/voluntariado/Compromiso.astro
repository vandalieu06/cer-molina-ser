---
import { CheckCircle2 } from "@lucide/astro";
const requisitos = [
  "Ser mayor de edad (18 años).",
  "Compromiso mínimo de 4 horas semanales.",
  "Respeto absoluto por el protocolo CER y bienestar animal.",
  "Capacidad de trabajo en equipo y empatía.",
  "Asistir a la formación inicial para voluntarios.",
];
---

<section
  class="py-20 bg-maroon-900 text-white flex justify-center overflow-hidden relative"
>
  <div
    class="w-full xl:max-w-7xl px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
  >
    <div>
      <h2 class="text-4xl font-bold tracking-tight italic mb-6 font-serif">
        Requisitos y <span class="text-gold">Compromiso</span>
      </h2>
      <p class="text-cream-dark/70 text-lg mb-8 leading-relaxed font-sans">
        Ser voluntario en CER Molina Segura requiere responsabilidad. No solo
        trabajamos con animales, sino con una comunidad que confía en nosotros.
      </p>
      <ul class="space-y-4">
        {
          requisitos.map((req) => (
            <li class="flex items-center gap-3">
              <CheckCircle2 class="text-gold shrink-0" size={20} />
              <span class="text-cream-dark font-sans">{req}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div
      class="bg-white/5 border border-maroon-700/30 p-8 rounded-2xl backdrop-blur-sm"
    >
      <h3 class="text-2xl font-bold mb-4 text-gold italic font-serif">
        ¿Qué ofrecemos?
      </h3>
      <p class="text-cream-dark/80 mb-4 italic font-sans">
        "Formar parte de una familia que lucha por un mundo mejor, formación
        continua y la satisfacción de salvar vidas diariamente."
      </p>
      <div class="h-1 w-20 bg-maroon-500"></div>
    </div>
  </div>
</section>
