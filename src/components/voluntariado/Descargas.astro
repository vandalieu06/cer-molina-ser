---
import { Download } from "@lucide/astro";
const documentos = [
  { nombre: "Guía del Voluntario 2025", peso: "1.2 MB" },
  { nombre: "Protocolo de Seguridad Alimentadores", peso: "850 KB" },
  { nombre: "Estatutos de la Asociación", peso: "2.1 MB" },
];
---

<section class="py-16 bg-cream flex justify-center border-b border-cream-dark">
  <div class="w-full xl:max-w-7xl px-6">
    <h2 class="text-2xl font-bold text-maroon-900 italic mb-8 font-serif">
      Documentación de interés
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {
        documentos.map((doc) => (
          <a
            href="#"
            class="flex items-center justify-between p-4 bg-white border border-cream-dark rounded-xl hover:border-maroon-500 transition-colors group"
          >
            <div class="flex items-center gap-3">
              <div class="p-2 bg-maroon-50 text-maroon-500 rounded-lg group-hover:bg-maroon-500 group-hover:text-white transition-colors">
                <Download size={20} />
              </div>
              <div>
                <p class="font-bold text-maroon-900 text-sm leading-tight font-sans">
                  {doc.nombre}
                </p>
                <p class="text-xs text-neutral-light font-sans">{doc.peso}</p>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
