<section class="py-24 bg-white flex justify-center">
  <div class="w-full xl:max-w-4xl px-6">
    <div class="text-center mb-12">
      <h2 class="text-4xl font-bold text-gray-900 tracking-tight italic">
        Únete a nuestra <span
          class="text-blue-700 underline decoration-orange-400">misión</span>
      </h2>
      <p class="text-gray-500 mt-4">
        Completa tus datos y nos pondremos en contacto contigo para una
        entrevista.
      </p>
    </div>

    <form class="grid grid-cols-1 gap-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <input
          type="text"
          placeholder="Nombre completo"
          class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-700 outline-none"
        />
        <input
          type="email"
          placeholder="Correo electrónico"
          class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-700 outline-none"
        />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <input
          type="tel"
          placeholder="Teléfono de contacto"
          class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-700 outline-none"
        />
        <select
          class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-700 outline-none text-gray-500"
        >
          <option disabled selected>Interés principal...</option>
          <option>Alimentación</option>
          <option>Capturas/CER</option>
          <option>Eventos</option>
          <option>Otros</option>
        </select>
      </div>
      <textarea
        rows="5"
        placeholder="Cuéntanos un poco sobre ti y tu experiencia con animales..."
        class="w-full p-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-700 outline-none"
      ></textarea>

      <div class="flex items-start gap-3 px-2">
        <input
          type="checkbox"
          class="mt-1 w-4 h-4 text-blue-700 border-gray-300 rounded focus:ring-blue-700"
        />
        <label class="text-xs text-gray-500"
          >Acepto la política de privacidad y el compromiso de voluntariado de
          CER Molina Segura.</label
        >
      </div>

      <button
        class="w-full py-4 bg-blue-700 hover:bg-blue-800 text-white font-bold rounded-xl transition-all shadow-lg shadow-blue-200 uppercase tracking-widest"
      >
        Enviar Inscripción
      </button>
    </form>
  </div>
</section>
