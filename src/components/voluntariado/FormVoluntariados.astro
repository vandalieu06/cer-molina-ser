<section class="py-24 bg-cream flex justify-center">
  <div class="w-full xl:max-w-4xl px-6">
    <div class="text-center mb-12">
      <h2 class="text-4xl font-bold text-maroon-900 tracking-tight italic font-serif">
        Únete a nuestra <span
          class="text-maroon-500 underline decoration-gold">misión</span>
      </h2>
      <p class="text-neutral mt-4 font-sans">
        Completa tus datos y nos pondremos en contacto contigo para una
        entrevista.
      </p>
    </div>

    <form class="grid grid-cols-1 gap-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <input
          type="text"
          placeholder="Nombre completo"
          class="w-full p-4 bg-white border border-cream-dark rounded-xl focus:ring-2 focus:ring-maroon-500 outline-none font-sans"
        />
        <input
          type="email"
          placeholder="Correo electrónico"
          class="w-full p-4 bg-white border border-cream-dark rounded-xl focus:ring-2 focus:ring-maroon-500 outline-none font-sans"
        />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <input
          type="tel"
          placeholder="Teléfono de contacto"
          class="w-full p-4 bg-white border border-cream-dark rounded-xl focus:ring-2 focus:ring-maroon-500 outline-none font-sans"
        />
        <select
          class="w-full p-4 bg-white border border-cream-dark rounded-xl focus:ring-2 focus:ring-maroon-500 outline-none text-neutral font-sans"
        >
          <option disabled selected>Interés principal...</option>
          <option>Alimentación</option>
          <option>Capturas/CER</option>
          <option>Eventos</option>
          <option>Otros</option>
        </select>
      </div>
      <textarea
        rows="5"
        placeholder="Cuéntanos un poco sobre ti y tu experiencia con animales..."
        class="w-full p-4 bg-white border border-cream-dark rounded-xl focus:ring-2 focus:ring-maroon-500 outline-none font-sans"
      ></textarea>

      <div class="flex items-start gap-3 px-2">
        <input
          type="checkbox"
          class="mt-1 w-4 h-4 text-maroon-500 border-cream-dark rounded focus:ring-maroon-500"
        />
        <label class="text-xs text-neutral font-sans"
          >Acepto la política de privacidad y el compromiso de voluntariado de
          CER Molina Segura.</label
        >
      </div>

      <button
        class="w-full py-4 bg-maroon-500 hover:bg-maroon-600 text-white font-bold rounded-xl transition-all shadow-lg shadow-maroon-500/10 uppercase tracking-widest font-sans"
      >
        Enviar Inscripción
      </button>
    </form>
  </div>
</section>
