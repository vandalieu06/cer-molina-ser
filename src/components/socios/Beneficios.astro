---
import { CircleCheck, Heart } from "@lucide/astro";

const beneficios = [
  "Descuentos en clínicas veterinarias conveniadas.",
  "Participación activa en las asambleas y toma de decisiones.",
  "Carnet digital de socio/a de CER Molina Segura.",
  "Información exclusiva sobre rescates y campañas antes que en redes.",
  "Descuentos en merchandising y eventos de la protectora.",
];
---

<section class="py-20 bg-cream flex justify-center">
  <div class="w-full xl:max-w-7xl px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <span
          class="text-maroon-500 font-sans font-semibold tracking-widest uppercase text-sm"
        >
          Tu apoyo es vital
        </span>
        <h2
          class="text-4xl md:text-5xl font-bold text-maroon-900 tracking-tight italic mt-2 mb-6 font-serif"
        >
          ¿Por qué hacerte socio?
        </h2>
        <p class="text-neutral text-lg mb-8 leading-relaxed font-sans">
          Las cuotas de nuestros socios son la base que nos permite planificar
          capturas, pagar facturas veterinarias urgentes y mantener nuestras
          colonias alimentadas durante todo el año. Ser socio es ser el motor
          del cambio.
        </p>
        <ul class="space-y-4">
          {
            beneficios.map((ben) => (
              <li class="flex items-start gap-3">
                <div class="mt-1 bg-gold-light p-1 rounded-full text-gold">
                  <CircleCheck size={18} />
                </div>
                <span class="text-neutral font-medium font-sans">{ben}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="bg-maroon-900 rounded-xl p-10 text-white relative overflow-hidden shadow-2xl border border-cream-dark/40 shadow-maroon-500/10"
      >
        <div class="absolute top-0 right-0 p-8 opacity-10">
          <Heart size={150} />
        </div>
        <div class="relative z-10">
          <h3 class="text-2xl font-bold mb-2 font-serif">Cuota Anual Única</h3>
          <p class="text-cream-dark/70 mb-6 font-sans uppercase tracking-widest text-sm">
            Compromiso con la vida
          </p>
          <div class="flex items-baseline gap-2 mb-8">
            <span class="text-6xl font-black text-gold">40€</span>
            <span class="text-cream-dark/50 font-sans">/ año</span>
          </div>
          <p
            class="text-cream-dark text-sm italic mb-8 border-l-2 border-gold pl-4 font-sans"
          >
            "Menos de 4 euros al mes para asegurar que ninguna camada nazca en
            el desamparo."
          </p>
          <a
            href="#formulario-socio"
            class="block w-full text-center bg-maroon-500 hover:bg-maroon-600 py-4 rounded-xl font-bold transition-all shadow-lg shadow-maroon-500/10 font-sans"
          >
            Quiero ser socio ahora
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
