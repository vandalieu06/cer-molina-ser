---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { Calendar, ArrowRight } from "@lucide/astro";
import { getPath } from "@utils/paths";

const posts = (await getCollection("blog"))
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  )
  .slice(0, 3);
---

<section class="py-16 bg-gray-50 flex justify-center border-t border-gray-100">
  <div class="w-full xl:max-w-7xl px-6">
    <!-- Titulo y Link a todas noticias -->
    <div
      class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4"
    >
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 italic">
          Actualidad felina y campañas
        </h2>
        <p class="text-lg text-gray-600 mt-2">
          Descubre cómo estamos mejorando la vida de nuestros gatos.
        </p>
      </div>
      <a
        href={getPath("/noticias")}
        class="text-blue-700 font-bold hover:underline flex items-center gap-2 text-lg group"
      >
        Ver todo el blog
        <ArrowRight
          size={20}
          class="group-hover:translate-x-1 transition-transform"
        />
      </a>
    </div>
    <!-- Vista de Noticias -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      {
        posts.map((post) => (
          <article class="bg-white rounded-3xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-xl transition-all group flex flex-col">
            <div class="aspect-video overflow-hidden">
              <Image
                src={post.data.image}
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-8 flex flex-col flex-1">
              <div class="flex items-center gap-3 mb-4">
                <span class="bg-orange-100 text-orange-800 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
                  {post.data.tag}
                </span>
                <div class="flex items-center text-gray-400 text-sm">
                  <Calendar size={14} class="mr-1" />
                  {post.data.date}
                </div>
              </div>
              <h2 class="text-2xl font-bold text-gray-900 mb-4 leading-tight group-hover:text-blue-700 transition-colors">
                {post.data.title}
              </h2>
              <p class="text-gray-600 mb-8 line-clamp-3 italic">
                {post.data.excerpt}
              </p>
              <a
                href={getPath(`/noticias/${post.slug}`)}
                class="mt-auto flex items-center gap-2 text-blue-700 font-black uppercase text-xs tracking-[0.2em] hover:gap-4 transition-all"
              >
                Leer noticia completa
                <ArrowRight
                  size={16}
                  class="group-hover:translate-x-1 transition-transform"
                />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
