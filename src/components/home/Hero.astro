---
import { Picture } from "astro:assets";
import bgImageWelcome from "@assets/web/home-hero.webp";
import { getPath } from "@utils/paths";
const alt =
  "Foto de Batitay Japheth: https://www.pexels.com/es-es/foto/animal-mascota-cabeza-gato-16679036/";
---

<section
  class="relative isolate min-h-[60vh] py-12 flex items-center justify-center overflow-hidden"
>
  <Picture
    src={bgImageWelcome}
    formats={["avif", "webp"]}
    fallbackFormat="webp"
    widths={[768, 1280, 1920]}
    sizes="100vw"
    alt=""
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
  />
  <div
    class="absolute inset-0 -z-10 bg-linear-to-r from-[#4f0000]/85 to-[#4f0000]/40"
  >
  </div>

  <div class="relative z-10 w-full xl:max-w-7xl px-6 flex flex-col gap-4">
    <span
      class="text-gold font-semibold tracking-widest uppercase text-sm font-sans"
    >
      CER Molina Segura
    </span>
    <h2
      class="text-5xl md:text-7xl font-bold text-white tracking-tight font-serif"
    >
      Bienvenido
    </h2>
    <p class="text-cream-dark text-lg font-sans">
      Buscamos a los mejores adoptantes del mundo
    </p>
    <a
      href={getPath("/adopciones")}
      class="w-max px-5 py-2 text-white bg-maroon-500 hover:bg-maroon-600 font-medium rounded-lg cursor-pointer transition-colors duration-300 ease-in-out font-sans"
      type="button"
    >
      Informate ahora
    </a>
  </div>
</section>

