---
import bgImageWelcome from "@assets/bg-home-welcome.jpg";
const alt =
  "Foto de Batitay Japheth: https://www.pexels.com/es-es/foto/animal-mascota-cabeza-gato-16679036/";
---

<section
  class="welcome-section min-h-[60vh] py-12 flex items-center justify-center"
>
  <div class="w-full xl:max-w-7xl px-6 flex flex-col gap-4">
    <span class="text-gold font-semibold tracking-widest uppercase text-sm font-sans">
      CER Molina Segura
    </span>
    <h2 class="text-5xl md:text-7xl font-bold text-white tracking-tight font-serif">
      Bienvenido
    </h2>
    <p class="text-cream-dark text-lg font-sans">
      Buscamos a los mejores adoptantes del mundo
    </p>
    <a
      href="/adopciones"
      class="w-max px-5 py-2 text-white bg-maroon-500 hover:bg-maroon-600 rounded-lg cursor-pointer transition-colors duration-300 ease-in-out font-sans"
      type="button"
    >
      Informate ahora
    </a>
  </div>
</section>

<style define:vars={{ bgUrl: `url(${bgImageWelcome.src})` }}>
  .welcome-section {
    background-image:
      linear-gradient(to right, rgba(79, 0, 0, 0.85) 0%, rgba(79, 0, 0, 0.5) 100%),
      var(--bgUrl);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
  }
</style>
