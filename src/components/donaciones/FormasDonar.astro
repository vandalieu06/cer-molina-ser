---
import { Smartphone, Landmark, Heart } from "@lucide/astro";
---

<section class="py-20 bg-cream flex justify-center">
  <div class="w-full xl:max-w-7xl px-6">
    <div class="mb-12">
      <span
        class="text-gold font-semibold tracking-widest uppercase text-sm font-sans"
      >
        Aportaciones puntuales
      </span>
      <h2 class="text-4xl font-bold text-maroon-900 tracking-tight italic mt-2 font-serif">
        Formas de Donar
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div
        class="p-8 rounded-2xl border border-cream-dark bg-white flex flex-col items-center text-center"
      >
        <div
          class="w-16 h-16 bg-gold text-white rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-gold/20"
        >
          <Smartphone size={32} />
        </div>
        <h3 class="text-2xl font-bold text-maroon-900 mb-2 font-serif">Bizum</h3>
        <p class="text-neutral mb-6 text-sm font-sans">
          La forma más rápida de ayudarnos con cualquier importe.
        </p>
        <span
          class="text-2xl font-black text-gold tracking-widest font-mono"
        >
          000000000
        </span>
      </div>

      <div
        class="p-8 rounded-2xl border border-cream-dark bg-white flex flex-col items-center text-center"
      >
        <div
          class="w-16 h-16 bg-maroon-500 text-white rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-maroon-500/10"
        >
          <Landmark size={32} />
        </div>
        <h3 class="text-2xl font-bold text-maroon-900 mb-2 font-serif">Transferencia</h3>
        <p class="text-neutral mb-4 text-sm font-sans">
          Ideal para donaciones recurrentes o importes mayores.
        </p>
        <p
          class="text-xs font-mono text-neutral bg-cream p-3 rounded-lg border border-cream-dark break-all"
        >
          ES00 1234 5678 9012 3456 7890
        </p>
      </div>

      <div
        class="p-8 rounded-2xl border border-cream-dark bg-white flex flex-col items-center text-center"
      >
        <div
          class="w-16 h-16 bg-gold text-white rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-gold/20"
        >
          <Heart size={32} />
        </div>
        <h3 class="text-2xl font-bold text-maroon-900 mb-2 font-serif">Teaming</h3>
        <p class="text-neutral mb-6 text-sm font-sans">
          Solo 1€ al mes. Pequeños gestos que hacen grandes cambios.
        </p>
        <a
          href="https://www.teaming.net/cermolinadesegura"
          class="text-gold font-bold hover:underline italic flex items-center gap-2 font-sans"
          target="_blank"
        >
          Unirse al grupo Teaming
        </a>
      </div>
    </div>
  </div>
</section>
