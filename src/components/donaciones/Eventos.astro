---
import { Calendar, MapPin } from "@lucide/astro";

const proximosEventos = [
  {
    fecha: "15 Ene",
    titulo: "Mercadillo Solidario",
    lugar: "Plaza del Ayuntamiento",
    desc: "Venta de artesanía y repostería casera a favor del método CER.",
  },
  {
    fecha: "22 Ene",
    titulo: "Charla Concienciación",
    lugar: "Biblioteca Municipal",
    desc: "Cómo convivir con colonias felinas en nuestro barrio.",
  },
];
---

<section class="py-20 bg-cream flex justify-center">
  <div class="w-full xl:max-w-7xl px-6">
    <h2 class="text-3xl font-bold text-maroon-900 italic mb-12 font-serif">
      Calendario de Eventos
    </h2>
    <div class="space-y-6">
      {
        proximosEventos.map((evento) => (
          <div class="flex flex-col md:flex-row gap-6 p-6 rounded-2xl border border-cream-dark hover:shadow-md transition-shadow items-center bg-white">
            <div class="bg-maroon-500 text-white p-4 rounded-xl text-center min-w-25">
              <span class="block text-2xl font-black">
                {evento.fecha.split(" ")[0]}
              </span>
              <span class="text-xs uppercase tracking-widest">
                {evento.fecha.split(" ")[1]}
              </span>
            </div>
            <div class="flex-1">
              <h3 class="text-xl font-bold text-maroon-900 font-serif">{evento.titulo}</h3>
              <p class="text-neutral text-sm mt-1 font-sans">{evento.desc}</p>
            </div>
            <div class="flex items-center gap-2 text-neutral-light text-sm font-sans">
              <MapPin size={18} class="text-gold" />
              {evento.lugar}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
