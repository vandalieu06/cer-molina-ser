---
import {
  FileText,
  ShieldAlert,
  BookOpen,
  Download,
  FileSignature,
} from "@lucide/astro";

const recursos = [
  {
    titulo: "Guía de Buenas Prácticas",
    descripcion:
      "Manual completo sobre la gestión ética de colonias felinas y convivencia urbana.",
    icon: BookOpen,
    peso: "2.4 MB",
    color: "bg-blue-100 text-blue-700",
  },
  {
    titulo: "Protocolo de Capturas CER",
    descripcion:
      "Instrucciones técnicas paso a paso para realizar capturas seguras y éticas.",
    icon: FileText,
    peso: "1.1 MB",
    color: "bg-orange-100 text-orange-700",
  },
  {
    titulo: "Modelo de Denuncia Administrativa",
    descripcion:
      "Plantilla para denunciar casos de abandono, maltrato o envenenamiento en la vía pública.",
    icon: ShieldAlert,
    peso: "850 KB",
    color: "bg-red-100 text-red-700",
  },
  {
    titulo: "Acuerdo de Voluntariado",
    descripcion:
      "Documento oficial de compromiso y derechos del voluntario de CER Molina Segura.",
    icon: FileSignature,
    peso: "1.5 MB",
    color: "bg-green-100 text-green-700",
  },
];
---

<section class="py-20 bg-white flex justify-center">
  <div class="w-full xl:max-w-7xl px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        recursos.map((item) => (
          <div class="flex flex-col sm:flex-row items-start gap-6 p-8 bg-gray-50 rounded-3xl border border-gray-100 hover:border-blue-200 transition-all group">
            <div
              class={`p-4 rounded-2xl ${item.color} group-hover:scale-110 transition-transform`}
            >
              <item.icon size={32} />
            </div>
            <div class="flex-1">
              <h3 class="text-xl font-bold text-gray-900 mb-2">
                {item.titulo}
              </h3>
              <p class="text-gray-600 text-sm leading-relaxed mb-6">
                {item.descripcion}
              </p>
              <a
                href="#"
                class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-gray-200 text-gray-700 font-bold text-sm rounded-xl hover:bg-blue-700 hover:text-white hover:border-blue-700 transition-all shadow-sm"
                download
              >
                <Download size={18} />
                Descargar PDF{" "}
                <span class="text-xs opacity-60 font-normal">
                  ({item.peso})
                </span>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
