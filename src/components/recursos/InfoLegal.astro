---
import { ShieldAlert, ArrowRight } from "@lucide/astro";
---

<section class="py-16 flex justify-center">
  <div class="w-full xl:max-w-7xl px-6">
    <div class="relative group">
      <div
        class="absolute -inset-1 bg-linear-to-r from-blue-600 to-orange-500 rounded-3xl blur opacity-25 group-hover:opacity-40 transition duration-1000"
      >
      </div>

      <div
        class="relative bg-gray-900 rounded-3xl p-8 md:p-14 overflow-hidden shadow-2xl"
      >
        <div
          class="absolute top-0 right-0 w-64 h-64 bg-blue-600/10 rounded-full -translate-y-1/2 translate-x-1/2 blur-3xl"
        >
        </div>

        <div
          class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center relative z-10"
        >
          <div class="lg:col-span-1 flex justify-center lg:justify-start">
            <div
              class="w-16 h-16 bg-orange-500/10 border border-orange-500/20 rounded-2xl flex items-center justify-center text-orange-500"
            >
              <ShieldAlert size={40} />
            </div>
          </div>

          <div class="lg:col-span-7 text-center lg:text-left">
            <h2
              class="text-3xl md:text-4xl font-bold text-white italic tracking-tight mb-4"
            >
              Protección <span class="text-blue-400">Jurídica Felina</span>
            </h2>
            <p class="text-gray-400 text-lg leading-relaxed max-w-2xl">
              Si presencias un acto de maltrato o envenenamiento, **tu
              testimonio es la herramienta más poderosa**. Nuestros modelos
              están diseñados para cumplir con la normativa de Molina de Segura
              y facilitar tu labor ante las autoridades.
            </p>
          </div>

          <div class="lg:col-span-4 flex flex-col gap-4">
            <a
              href="/contacto"
              class="group/btn flex items-center justify-center gap-3 px-8 py-5 bg-blue-700 hover:bg-blue-800 text-white font-black rounded-2xl transition-all shadow-xl shadow-blue-900/20"
            >
              SOLICITAR AYUDA
              <ArrowRight
                size={20}
                class="group-hover/btn:translate-x-2 transition-transform"
              />
            </a>
            <p
              class="text-center text-xs text-gray-500 uppercase tracking-widest font-bold"
            >
              Respuesta en menos de 48h
            </p>
          </div>
        </div>

        <div
          class="absolute bottom-0 left-0 h-1 bg-linear-to-r from-blue-600 via-blue-400 to-orange-500 w-full"
        >
        </div>
      </div>
    </div>
  </div>
</section>
