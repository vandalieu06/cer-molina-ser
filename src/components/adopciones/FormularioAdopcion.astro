<section class="py-20 bg-gray-900 flex justify-center overflow-hidden">
  <div class="w-full xl:max-w-4xl px-6">
    <div class="bg-white rounded-3xl p-8 md:p-12 shadow-2xl">
      <h2 class="text-3xl font-bold text-gray-900 italic mb-8">
        Solicitud de Adopción
      </h2>
      <form class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex flex-col gap-2">
            <label
              class="font-bold text-sm text-gray-700 uppercase tracking-wider"
              >Nombre Completo</label
            >
            <input
              type="text"
              placeholder="Tu nombre"
              class="p-3 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-700 outline-none"
            />
          </div>
          <div class="flex flex-col gap-2">
            <label
              class="font-bold text-sm text-gray-700 uppercase tracking-wider"
              >Email</label
            >
            <input
              type="email"
              placeholder="email@ejemplo.com"
              class="p-3 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-700 outline-none"
            />
          </div>
        </div>
        <div class="flex flex-col gap-2">
          <label
            class="font-bold text-sm text-gray-700 uppercase tracking-wider"
            >¿Por qué quieres adoptar?</label
          >
          <textarea
            rows="4"
            class="p-3 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-700 outline-none"
          ></textarea>
        </div>
        <button
          class="w-full py-4 bg-blue-700 hover:bg-blue-800 text-white font-bold rounded-xl transition-colors uppercase tracking-widest shadow-lg"
        >
          Enviar Cuestionario
        </button>
      </form>
    </div>
  </div>
</section>
