<section class="py-20 bg-maroon-900 flex justify-center overflow-hidden">
  <div class="w-full xl:max-w-4xl px-6">
    <div class="bg-white rounded-2xl p-8 md:p-12 shadow-2xl shadow-maroon-500/10">
      <h2 class="text-3xl font-bold text-maroon-900 italic mb-8 font-serif">
        Solicitud de Adopción
      </h2>
      <form class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex flex-col gap-2">
            <label
              class="font-bold text-sm text-neutral uppercase tracking-wider font-sans"
              >Nombre Completo</label
            >
            <input
              type="text"
              placeholder="Tu nombre"
              class="p-3 bg-cream border border-cream-dark rounded-lg focus:ring-2 focus:ring-maroon-500 outline-none font-sans"
            />
          </div>
          <div class="flex flex-col gap-2">
            <label
              class="font-bold text-sm text-neutral uppercase tracking-wider font-sans"
              >Email</label
            >
            <input
              type="email"
              placeholder="email@ejemplo.com"
              class="p-3 bg-cream border border-cream-dark rounded-lg focus:ring-2 focus:ring-maroon-500 outline-none font-sans"
            />
          </div>
        </div>
        <div class="flex flex-col gap-2">
          <label
            class="font-bold text-sm text-neutral uppercase tracking-wider font-sans"
            >¿Por qué quieres adoptar?</label
          >
          <textarea
            rows="4"
            class="p-3 bg-cream border border-cream-dark rounded-lg focus:ring-2 focus:ring-maroon-500 outline-none font-sans"
          ></textarea>
        </div>
        <button
          class="w-full py-4 bg-maroon-500 hover:bg-maroon-600 text-white font-bold rounded-xl transition-colors uppercase tracking-widest shadow-lg shadow-maroon-500/10 font-sans"
        >
          Enviar Cuestionario
        </button>
      </form>
    </div>
  </div>
</section>
