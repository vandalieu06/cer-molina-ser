---
import { MessageSquareQuote } from "@lucide/astro";
import tmpImage from "@assets/tmp-person-with-cat.jpg";

const historias = [
  {
    nombre: "Luna y su nueva familia",
    relato:
      "Luna paso 2 anos en el refugio. Ahora no se despega de su hermano humano. Es la reina de la casa!",
    img: tmpImage.src,
  },
  {
    nombre: "El cambio de Bigotes",
    relato:
      "Llego muy asustado de una colonia, pero con paciencia ahora es el gato mas mimoso del mundo.",
    img: tmpImage.src,
  },
  {
    nombre: "El cambio de Bigotes",
    relato:
      "Llego muy asustado de una colonia, pero con paciencia ahora es el gato mas mimoso del mundo.",
    img: tmpImage.src,
  },
  {
    nombre: "El cambio de Bigotes",
    relato:
      "Llego muy asustado de una colonia, pero con paciencia ahora es el gato mas mimoso del mundo.",
    img: tmpImage.src,
  },
];
---

<section class="py-20 bg-cream flex justify-center">
  <div class="w-full xl:max-w-7xl px-6">
    <h2
      class="text-3xl md:text-4xl font-bold text-maroon-900 italic mb-12 font-serif"
    >
      Finales Felices
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      {
        historias.map((h) => (
          <div class="flex flex-col md:flex-row gap-6 items-center bg-maroon-50/50 p-6 rounded-2xl border border-maroon-100">
            <img
              src={h.img}
              alt={h.nombre}
              class="w-40 h-40 rounded-2xl object-cover shadow-md"
            />
            <div>
              <MessageSquareQuote class="text-maroon-500 mb-2" size={32} />
              <h3 class="text-xl font-bold text-maroon-900 mb-2 font-serif">
                {h.nombre}
              </h3>
              <p class="text-neutral italic font-sans">{h.relato}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
