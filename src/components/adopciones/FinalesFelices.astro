  ---
  import { MessageSquareQuote } from "@lucide/astro";
  import tmpImage from "@assets/tmp-person-with-cat.jpg";
  
  const historias = [
    {
      nombre: "Luna y su nueva familia",
      relato:
        "Luna pasó 2 años en el refugio. Ahora no se despega de su hermano humano. ¡Es la reina de la casa!",
      img: tmpImage.src,
    },
    {
      nombre: "El cambio de Bigotes",
      relato:
        "Llegó muy asustado de una colonia, pero con paciencia ahora es el gato más mimoso del mundo.",
      img: tmpImage.src,
    },
    {
      nombre: "El cambio de Bigotes",
      relato:
        "Llegó muy asustado de una colonia, pero con paciencia ahora es el gato más mimoso del mundo.",
      img: tmpImage.src,
    },
    {
      nombre: "El cambio de Bigotes",
      relato:
        "Llegó muy asustado de una colonia, pero con paciencia ahora es el gato más mimoso del mundo.",
      img: tmpImage.src,
    },
  ];
  ---
  
  <section class="py-20 bg-white flex justify-center">
    <div class="w-full xl:max-w-7xl px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 italic mb-12">
        Finales Felices
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        {
          historias.map((h) => (
            <div class="flex flex-col md:flex-row gap-6 items-center bg-blue-50/50 p-6 rounded-3xl border border-blue-100">
              <img
                src={h.img}
                alt={h.nombre}
                class="w-40 h-40 rounded-2xl object-cover shadow-md"
              />
              <div>
                <MessageSquareQuote class="text-blue-700 mb-2" size={32} />
                <h3 class="text-xl font-bold text-gray-900 mb-2">{h.nombre}</h3>
                <p class="text-gray-600 italic">"{h.relato}"</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
