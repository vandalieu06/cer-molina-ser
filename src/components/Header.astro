---
import { Menu, X } from "@lucide/astro";
import { pages, pageTitle } from "@data/pages";

interface Page {
  title: string;
  url: string;
}

// Obtenemos la ruta actual para marcar el enlace activo
const { pathname } = Astro.url;
const normalizedPathname = pathname.replace(/\/$/, "");
---

<header
  class="py-6 flex justify-center relative bg-white border-b border-gray-50"
>
  <div class="w-full xl:max-w-7xl px-6 flex justify-between items-center">
    <!-- Logo -->
    <div class="z-50">
      <a href="/" class="group">
        <h1
          class="text-xl font-bold tracking-tight text-gray-900 group-hover:text-blue-700 transition-colors"
        >
          {pageTitle}
        </h1>
      </a>
    </div>

    <!-- Navegación Desktop / Tablet -->
    <nav class="hidden lg:flex items-center">
      <ul class="flex gap-x-6">
        {
          pages.map((page: Page) => {
            const isActive =
              normalizedPathname === page.url.replace(/\/$/, "") ||
              (pathname === "/" && page.url === "/");
            return (
              <li>
                <a
                  href={page.url}
                  class={`text-sm font-bold transition-all hover:text-blue-700 ${
                    isActive
                      ? "text-blue-700 underline underline-offset-8"
                      : "text-gray-600"
                  }`}
                >
                  {page.title}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Botón Menú Móvil (Cambiado a 'lg' para que en tablets se vea el hamburguesa si hay muchos links) -->
    <button
      id="menu-toggle"
      aria-label="Abrir menú"
      class="lg:hidden z-50 p-2 focus:outline-none group text-gray-900"
    >
      <div class="relative w-6 h-6">
        <div
          id="menu-icon-container"
          class="absolute inset-0 transition-all duration-300 scale-100 opacity-100 rotate-0"
        >
          <Menu class="w-6 h-6" />
        </div>
        <div
          id="close-icon-container"
          class="absolute inset-0 transition-all duration-300 scale-50 opacity-0 -rotate-90"
        >
          <X class="w-6 h-6" />
        </div>
      </div>
    </button>

    <!-- Menú Móvil Fullscreen -->
    <div
      id="mobile-menu"
      class="fixed inset-0 bg-white/98 backdrop-blur-xl z-40 flex flex-col items-center justify-center transition-all duration-500 ease-in-out opacity-0 pointer-events-none -translate-y-2.5"
    >
      <nav class="text-center overflow-y-auto max-h-screen py-20">
        <ul class="flex flex-col gap-8">
          {
            pages.map((page: Page) => (
              <li>
                <a
                  href={page.url}
                  class="mobile-link text-3xl font-bold tracking-tight text-gray-900 hover:text-blue-700 transition-colors cursor-pointer"
                >
                  {page.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const menuIcon = document.getElementById("menu-icon-container");
  const closeIcon = document.getElementById("close-icon-container");
  const body = document.body;
  const mobileLinks = document.querySelectorAll(".mobile-link");

  function toggleMenu() {
    const isOpen = menu?.classList.contains("opacity-100");

    if (!isOpen) {
      menu?.classList.remove(
        "opacity-0",
        "pointer-events-none",
        "translate-y-[-10px]",
      );
      menu?.classList.add(
        "opacity-100",
        "pointer-events-auto",
        "translate-y-0",
      );
      menuIcon?.classList.add("opacity-0", "scale-50", "rotate-90");
      closeIcon?.classList.remove("opacity-0", "scale-50", "-rotate-90");
      closeIcon?.classList.add("opacity-100", "scale-100", "rotate-0");
      body.style.overflow = "hidden";
    } else {
      menu?.classList.remove(
        "opacity-100",
        "pointer-events-auto",
        "translate-y-0",
      );
      menu?.classList.add(
        "opacity-0",
        "pointer-events-none",
        "translate-y-[-10px]",
      );
      menuIcon?.classList.remove("opacity-0", "scale-50", "rotate-90");
      closeIcon?.classList.add("opacity-0", "scale-50", "-rotate-90");
      closeIcon?.classList.remove("opacity-100", "scale-100", "rotate-0");
      body.style.overflow = "";
    }
  }

  btn?.addEventListener("click", toggleMenu);
  mobileLinks.forEach((link) => {
    link.addEventListener("click", toggleMenu);
  });
</script>
