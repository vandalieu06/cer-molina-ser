---
import { Image } from "astro:assets";
import { ChevronDown, Menu, X } from "@lucide/astro";
import Link from "@components/global/Link.astro";
import { pages, type Page } from "@data/pages";
import { getPath } from "@utils/paths";
import imglogo from "@assets/logo.png";

const { pathname } = Astro.url;
const normalizedPathname = pathname.replace(/\/$/, "");
---

<header class="py-1 flex justify-center relative bg-cream">
  <div class="w-full xl:max-w-7xl px-6 flex justify-between items-center">
    <!-- Logo -->
    <div class="z-50">
      <a href={getPath("/")}>
        <Image src={imglogo} alt="Logo de web" class="w-25" />
      </a>
    </div>

    <!-- Navegación Desktop / Tablet -->
    <nav class="hidden lg:flex items-center">
      <ul class="flex gap-x-6">
        {
          pages.map((page: Page) => {
            const isActive =
              normalizedPathname === getPath(page.url).replace(/\/$/, "");
            if (page.children) {
              const hasActiveChild = page.children.some(
                (child) =>
                  normalizedPathname === getPath(child.url).replace(/\/$/, ""),
              );
              return (
                <li class="relative group">
                  <button
                    class={`flex items-center gap-1 text-sm font-bold transition-all font-sans hover:text-maroon-500 cursor-pointer ${
                      hasActiveChild ? "text-maroon-500" : "text-neutral"
                    }`}
                  >
                    {page.title}
                    <ChevronDown
                      class="w-4 h-4 transition-transform group-hover:rotate-180"
                    />
                  </button>
                  <div class="absolute top-full left-0 mt-2 bg-cream rounded-xl shadow-lg border border-maroon-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 min-w-44 py-2 z-50">
                    {page.children.map((child) => {
                      const isChildActive =
                        normalizedPathname ===
                        getPath(child.url).replace(/\/$/, "");
                      return (
                        <a
                          href={getPath(child.url)}
                          class={`block px-4 py-2 text-sm font-sans transition-colors ${
                            isChildActive
                              ? "text-maroon-500 bg-maroon-50 font-bold"
                              : "text-neutral hover:text-maroon-500 hover:bg-maroon-50"
                          }`}
                        >
                          {child.title}
                        </a>
                      );
                    })}
                  </div>
                </li>
              );
            }
            return (
              <Link
                url={getPath(page.url)}
                text={page.title}
                isActive={isActive}
                isDesktop={true}
              />
            );
          })
        }
      </ul>
    </nav>

    <!-- Botón Menú Móvil -->
    <button
      id="menu-toggle"
      aria-label="Abrir menú"
      class="lg:hidden z-50 p-2 focus:outline-none group text-maroon-900"
    >
      <div class="relative w-6 h-6">
        <div
          id="menu-icon-container"
          class="absolute inset-0 transition-all duration-300 scale-100 opacity-100 rotate-0"
        >
          <Menu class="w-6 h-6" />
        </div>
        <div
          id="close-icon-container"
          class="absolute inset-0 transition-all duration-300 scale-50 opacity-0 -rotate-90"
        >
          <X class="w-6 h-6" />
        </div>
      </div>
    </button>

    <!-- Menú Móvil Fullscreen -->
    <div
      id="mobile-menu"
      class="fixed inset-0 bg-cream/98 backdrop-blur-xl z-40 flex flex-col items-center justify-center transition-all duration-500 ease-in-out opacity-0 pointer-events-none -translate-y-2.5"
    >
      <nav class="text-center overflow-y-auto max-h-screen py-20">
        <ul class="flex flex-col gap-8">
          {
            pages.map((page: Page) => {
              const isActive =
                normalizedPathname === getPath(page.url).replace(/\/$/, "");
              if (page.children) {
                const hasActiveChild = page.children.some(
                  (child) =>
                    normalizedPathname ===
                    getPath(child.url).replace(/\/$/, ""),
                );
                return (
                  <li>
                    <button
                      class={`flex items-center justify-center gap-2 text-2xl font-bold tracking-tight transition-colors cursor-pointer w-full ${
                        hasActiveChild ? "text-maroon-500" : "text-neutral"
                      }`}
                      data-submenu-toggle
                    >
                      {page.title}
                      <ChevronDown class="w-5 h-5 transition-transform" />
                    </button>
                    <ul class="mt-4 space-y-4 hidden" data-submenu>
                      {page.children.map((child) => {
                        const isChildActive =
                          normalizedPathname ===
                          getPath(child.url).replace(/\/$/, "");
                        return (
                          <li>
                            <a
                              href={getPath(child.url)}
                              class={`mobile-link text-lg font-bold tracking-tight transition-colors cursor-pointer ${
                                isChildActive
                                  ? "text-maroon-500"
                                  : "text-neutral"
                              }`}
                            >
                              {child.title}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </li>
                );
              }
              return (
                <Link
                  url={getPath(page.url)}
                  text={page.title}
                  isActive={isActive}
                  isDesktop={false}
                />
              );
            })
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const menuIcon = document.getElementById("menu-icon-container");
  const closeIcon = document.getElementById("close-icon-container");
  const body = document.body;
  const mobileLinks = document.querySelectorAll(".mobile-link");

  function toggleMenu() {
    const isOpen = menu?.classList.contains("opacity-100");

    if (!isOpen) {
      menu?.classList.remove(
        "opacity-0",
        "pointer-events-none",
        "translate-y-[-10px]",
      );
      menu?.classList.add(
        "opacity-100",
        "pointer-events-auto",
        "translate-y-0",
      );
      menuIcon?.classList.remove("opacity-100", "scale-100", "rotate-0");
      menuIcon?.classList.add("opacity-0", "scale-50", "rotate-90");
      closeIcon?.classList.remove("opacity-0", "scale-50", "-rotate-90");
      closeIcon?.classList.add("opacity-100", "scale-100", "rotate-0");
      body.style.overflow = "hidden";
    } else {
      menu?.classList.remove(
        "opacity-100",
        "pointer-events-auto",
        "translate-y-0",
      );
      menu?.classList.add(
        "opacity-0",
        "pointer-events-none",
        "translate-y-[-10px]",
      );
      menuIcon?.classList.add("opacity-100", "scale-100", "rotate-0");
      menuIcon?.classList.remove("opacity-0", "scale-50", "rotate-90");
      closeIcon?.classList.add("opacity-0", "scale-50", "-rotate-90");
      closeIcon?.classList.remove("opacity-100", "scale-100", "rotate-0");
      body.style.overflow = "";
    }
  }

  btn?.addEventListener("click", toggleMenu);
  mobileLinks.forEach((link) => {
    link.addEventListener("click", toggleMenu);
  });

  document.querySelectorAll("[data-submenu-toggle]").forEach((toggleBtn) => {
    toggleBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      const submenu = toggleBtn.nextElementSibling;
      if (submenu?.hasAttribute("data-submenu")) {
        submenu.classList.toggle("hidden");
        const chevron = toggleBtn.querySelector(".lucide-chevron-down");
        chevron?.classList.toggle("rotate-180");
      }
    });
  });
</script>
