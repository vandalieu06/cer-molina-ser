---
import Layout from "@layouts/Layout.astro";
import GaleriaGatos from "@components/adopciones/GaleriaGatos.astro";
import type { ImageMetadata } from "astro";

interface ImageData {
  src: ImageMetadata;
  alt: string;
}

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/fichas_gatos/**/*.webp",
  { eager: true },
);

// Nombres con acento que el slug del fichero no puede representar.
const ACENTOS: Record<string, string> = {
  ambar: "Ámbar",
  felix: "Félix",
  lia: "Lía",
  lulu: "Lulú",
  principe: "Príncipe",
  tarzan: "Tarzán",
};

// slug → nombre visible: "ambar" → "Ámbar", "greta-2" → "Greta (2)"
function prettyName(slug: string): string {
  const dup = slug.match(/^(.*)-(\d+)$/);
  const base = dup ? dup[1] : slug;
  const nombre = ACENTOS[base] ?? base.charAt(0).toUpperCase() + base.slice(1);
  return dup ? `${nombre} (${dup[2]})` : nombre;
}

function categorize(prefix: string): ImageData[] {
  return Object.entries(imageModules)
    .filter(([path]) => path.includes(`/${prefix}/`))
    .map(([path, mod]) => {
      const filename = path.split("/").pop() || "";
      const slug = filename.replace(/\.webp$/, "");
      return {
        src: mod.default,
        alt: prettyName(slug),
      };
    })
    .sort((a, b) => a.alt.localeCompare(b.alt, "es"));
}

const enAdopcion = categorize("en_adopcion");
const adoptados = categorize("adoptados");
const fallecidos = categorize("fallecidos_desaparecidos");
---

<Layout>
  <section class="py-24 bg-maroon-900 text-cream text-center">
    <div class="w-full xl:max-w-7xl px-6 mx-auto">
      <h1 class="text-4xl md:text-5xl font-bold font-serif mb-4">
        Gatos en adopción
      </h1>
      <p class="text-lg text-cream-dark font-sans max-w-2xl mx-auto">
        Conoce a todos los gatos que han pasado por CER Molina Segura
      </p>
    </div>
  </section>

  <GaleriaGatos
    images={enAdopcion}
    titulo="Gatos en Adopción"
    subtitulo={`${enAdopcion.length} gatos buscando un hogar`}
  />

  <GaleriaGatos
    images={adoptados}
    titulo="Gatos Adoptados"
    subtitulo={`${adoptados.length} gatos encontraron su familia`}
    bgClass="bg-cream"
  />

  <GaleriaGatos
    images={fallecidos}
    titulo="Fallecidos / Desaparecidos"
    subtitulo={`${fallecidos.length} gatos`}
  />
</Layout>
